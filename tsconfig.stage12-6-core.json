{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true
  },
  "include": [
    "src/types/server-only.d.ts",
    "src/types/node-shims.d.ts",
    "src/types/hotel.ts",
    "src/types/booking.ts",
    "src/data/assets.ts",
    "src/data/rooms.ts",
    "src/data/commerce.ts",
    "src/data/booking.ts",
    "src/lib/booking/pricing.ts",
    "src/lib/booking/store.ts",
    "src/lib/booking/inventory.ts",
    "src/lib/booking/reservations.ts",
    "src/lib/booking/validation.ts",
    "src/lib/payments/provider.ts",
    "src/lib/payments/razorpay.ts"
  ]
}
