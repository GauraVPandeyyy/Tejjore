{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true
  },
  "include": [
    "src/types/hotel.ts",
    "src/types/arrival.ts",
    "src/data/hotel.ts",
    "src/data/nearby.ts",
    "src/data/arrival.ts",
    "src/lib/arrival/providers.ts",
    "src/lib/integrations/provider-types.ts"
  ]
}
