# ===== MINIMUM FOR A LIVE DEPLOYMENT (e.g. Vercel) =====
# Everything else below is optional and has a working default; staff configure nothing.
#   DATABASE_URL         your PostgreSQL connection string (TLS is on and verified automatically)
#   ADMIN_USERS_JSON + ADMIN_SESSION_SECRET   only if you want the /admin panel
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET   only for online payment
#   BREVO_API_KEY + BOOKING_EMAIL_FROM        only for booking e-mails
# Defaults on a production deployment: booking mode = production, public URL = https://tejjoralakeview.in,
# room counts = 10 Deluxe / 10 Super Deluxe / 9 Premium, max 2 adults per room, taxes off.
# Run once against the database: npm run db:migrate && npm run db:seed

# Optional AI provider key; the site must remain functional without it.
TEJJORA_AI_API_KEY=

# Analytics / future operational integrations.
NEXT_PUBLIC_GA_ID=
PMS_API_URL=
PMS_API_KEY=
PAYMENT_PROVIDER_KEY=
FLIGHT_API_KEY=

# Stage 12.4 — Google Maps + genuine Google review provider.
# Browser-safe key: restrict it by HTTP referrer and enable Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_ID=
# Hotel pin for the /location map (MapLibre + OpenFreeMap). Leave blank until the pin is confirmed in
# Google Maps; the map then shows the Gomti Nagar area, not a building. Must fall inside Lucknow.
NEXT_PUBLIC_HOTEL_LAT=
NEXT_PUBLIC_HOTEL_LNG=

# Server-only key: never expose this key to the browser. Enable Places API (New).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Production database. Required when BOOKING_MODE=production.
# Example: postgresql://user:password@host:5432/tejjora
# Also the source of site content (rooms, facts, FAQs, menu, media...). Without it, or before
# `npm run db:migrate` + `npm run db:seed`, pages render the built-in src/data fallback.
# `npm run db:verify` checks migrations + seed against a throwaway in-memory database instead.
DATABASE_URL=
# Set true when your managed PostgreSQL provider requires SSL (Supabase does).
DATABASE_SSL=false
# TLS verification for DATABASE_SSL=true. REQUIRED in production (unverified TLS is refused):
# the provider CA certificate as PEM (line breaks may be written as a literal \n) or base64, e.g. the Supabase
# "SSL certificate" from Project Settings > Database. Or set DATABASE_SSL_USE_SYSTEM_CA=true for a
# provider whose certificate chains to a public CA.
DATABASE_SSL_CA=
DATABASE_SSL_CA_BASE64=
DATABASE_SSL_USE_SYSTEM_CA=false
# Optional pool limit for the small hotel workload.
DATABASE_POOL_MAX=8

# Stage 12.6 — booking / inventory persistence.
# Local-development fallback only. Production booking mode requires DATABASE_URL.
BOOKING_STORE_PATH=
# Keep "development" until actual category inventory and tax/business rules are approved.
# Production online payment additionally requires BOOKING_MODE=production.
BOOKING_MODE=development
# Required before production online payment can be enabled.
BOOKING_PRODUCTION_READY=false
# Actual per-category room counts must replace development defaults before production.
INVENTORY_DELUXE=
INVENTORY_SUPER_DELUXE=
INVENTORY_PREMIUM=

# Stage 12.7 — Razorpay. Secrets are server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED for production online payment: without it payments stay disabled and webhooks are rejected.
# Create the webhook in the Razorpay dashboard (payment.captured, order.paid, payment.failed) -> /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=
# Development only. Never enable in production.
PAYMENT_TEST_MODE=false
# Public pricing configuration (business-approved values only).
NEXT_PUBLIC_TAX_CONFIGURED=false
NEXT_PUBLIC_TAX_RATE_BPS=0
NEXT_PUBLIC_SERVICE_CHARGE_CONFIGURED=false
NEXT_PUBLIC_SERVICE_CHARGE_BPS=0

# Stage 12.8 — staff operations / admin. Server-only.
# Generate each password hash with: node scripts/generate-admin-hash.mjs "your-password"
# role: owner | manager | front_desk | kitchen (enforced server-side; see src/lib/admin/permissions.ts).
# Give at least one account "role":"owner". Entries without a role are treated as "manager".
# Example shape only (do not copy):
# [{"id":"owner","name":"Hotel Owner","role":"owner","passwordHash":"scrypt$..."},
#  {"id":"frontdesk","name":"Front Desk","role":"front_desk","passwordHash":"scrypt$..."}]
# Staff sessions and the audit log are stored in PostgreSQL (migration 005): production staff
# sign-in requires DATABASE_URL. Changing an account's role signs that account out.
# In a .env/.env.local file every "$" inside a password hash must be written "\$" (Next.js expands $name and
# would delete part of the hash, so that account could never sign in). scripts/generate-admin-hash.mjs prints both forms.
ADMIN_USERS_JSON=
# Legacy single-user alternative (plain-text password). DEVELOPMENT ONLY: ignored when NODE_ENV=production.
# ADMIN_USER_ID=
# ADMIN_USER_NAME=
# ADMIN_PASSWORD=
# Use a random secret of at least 32 characters. It signs session cookies and keys audit IP hashes.
# Rotate it to invalidate all staff sessions at once (individual sessions are revocable in the admin).
ADMIN_SESSION_SECRET=
# Leave false unless the hotel deliberately permits offline/pay-at-hotel confirmation by staff.
ADMIN_ALLOW_MANUAL_CONFIRM=false

# Phase 3C — admin media uploads to Supabase Storage. Server-only: NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_URL is the project URL (https://<ref>.supabase.co); the service-role key stays on the
# server and is used only for Storage uploads/deletes. Create a PUBLIC bucket (default name below)
# with a 15 MB file limit and image/jpeg, image/png, image/webp, image/avif as allowed types.
# Without these, production media upload is disabled (development stores files in public/uploads).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=tejjora-media
# Local QA only (ignored in production): run content + admin CMS on an in-memory PGlite database.
# TEJJORA_QA_CONTENT_DB=pglite

# Concierge (Mezbaan). hybrid (default) = Gemini with read-only grounded tools when enabled below,
# otherwise the deterministic grounded router. deterministic = never call a model. rules = legacy rules only.
CONCIERGE_PROVIDER=hybrid

# Optional booking pricing rules. These are public commercial values, never secrets.
# Extra-adult charge applies per extra adult per night only when INCLUDED_ADULTS_PER_ROOM is set.
NEXT_PUBLIC_INCLUDED_ADULTS_PER_ROOM=
NEXT_PUBLIC_EXTRA_ADULT_CHARGE=
# Child charge, when configured, applies per child per night.
NEXT_PUBLIC_CHILD_CHARGE=
# Optional fixed nightly adjustments for non-room-only rate plans.
# Example: [{"id":"breakfast","adjustmentValue":500,"onlineBookable":true,"description":"Breakfast for the booked room(s)."}]
NEXT_PUBLIC_RATE_PLAN_CONFIG_JSON=
# Optional add-on pricing/enablement. Existing charge mode comes from the application catalog.
# Example: [{"id":"breakfast","amount":300,"onlineBookable":true},{"id":"airport-pickup","amount":1200,"onlineBookable":true}]
NEXT_PUBLIC_ADDON_CONFIG_JSON=
# Optional promo rules — SERVER-ONLY (no NEXT_PUBLIC_ prefix, so codes are not published in the browser bundle).
# Codes are validated and applied when the room is held. Example: [{"code":"WELCOME10","type":"percent","value":10,"enabled":true,"startDate":"2026-10-01","endDate":"2026-12-31","minNights":2}]
PROMO_CODES_JSON=

# V2 public site identity / SEO.
# REQUIRED for every production build/start (canonical URLs, sitemap, robots, structured data).
# Use the real public origin in production, or http://localhost:3000 for a local production build.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional public-facing hotel email. Leave blank until the hotel approves one.
NEXT_PUBLIC_HOTEL_EMAIL=

# Transactional booking emails — Brevo (server-only).
# Free plan currently supports up to 300 email sends/day.
# Create the API key in Brevo: Settings > SMTP & API > API Keys & MCP.
BREVO_API_KEY=
# Must be a verified Brevo sender address, e.g. reservations@yourdomain.com
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_FROM_NAME=Tejjora Lake View
# Optional: replies from the guest can go to this approved hotel mailbox.
BOOKING_EMAIL_REPLY_TO=

# Gemini FREE TIER only (no paid AI provider). Set CONCIERGE_LANGUAGE_PROVIDER=gemini plus a key and a
# free-tier Flash model id to let Mezbaan call read-only tools and word the answer. Every figure in the
# model's text is checked against tool results; on failure or quota it falls back to the deterministic
# answer. Guest e-mail, phone numbers and booking references are never sent to the model.
# Values: structured | gemini
CONCIERGE_LANGUAGE_PROVIDER=structured
GEMINI_API_KEY=
GEMINI_CONCIERGE_MODEL=
# Requests per India day before falling back to the deterministic router (counted in ai_usage). Default 200.
GEMINI_DAILY_REQUEST_LIMIT=200

# Rate limiting. The ONE request header your hosting platform sets to the real client IP.
# Default x-real-ip (Vercel, nginx proxy_set_header X-Real-IP). Behind Cloudflare use cf-connecting-ip.
# Never point this at a header clients can set themselves (e.g. a raw X-Forwarded-For chain).
TRUSTED_CLIENT_IP_HEADER=x-real-ip
