# Optional AI provider key; the site must remain functional without it.
TEJJORA_AI_API_KEY=

# Analytics / future operational integrations.
NEXT_PUBLIC_GA_ID=
PMS_API_URL=
PMS_API_KEY=
PAYMENT_PROVIDER_KEY=
FLIGHT_API_KEY=

# Stage 12.4 — Google Maps + genuine Google review provider.
# Browser-safe key: restrict it by HTTP referrer and enable Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_ID=

# Server-only key: never expose this key to the browser. Enable Places API (New).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Production database. Required when BOOKING_MODE=production.
# Example: postgresql://user:password@host:5432/tejjora
DATABASE_URL=
# Set true only when your managed PostgreSQL provider requires SSL.
DATABASE_SSL=false
# Optional pool limit for the small hotel workload.
DATABASE_POOL_MAX=8

# Stage 12.6 — booking / inventory persistence.
# Local-development fallback only. Production booking mode requires DATABASE_URL.
BOOKING_STORE_PATH=
# Keep "development" until actual category inventory and tax/business rules are approved.
# Production online payment additionally requires BOOKING_MODE=production.
BOOKING_MODE=development
# Required before production online payment can be enabled.
BOOKING_PRODUCTION_READY=false
# Actual per-category room counts must replace development defaults before production.
INVENTORY_DELUXE=
INVENTORY_SUPER_DELUXE=
INVENTORY_PREMIUM=

# Stage 12.7 — Razorpay. Secrets are server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Development only. Never enable in production.
PAYMENT_TEST_MODE=false
# Public pricing configuration (business-approved values only).
NEXT_PUBLIC_TAX_CONFIGURED=false
NEXT_PUBLIC_TAX_RATE_BPS=0
NEXT_PUBLIC_SERVICE_CHARGE_CONFIGURED=false
NEXT_PUBLIC_SERVICE_CHARGE_BPS=0

# Stage 12.8 — staff operations / admin. Server-only.
# Generate each password hash with: node scripts/generate-admin-hash.mjs "your-password"
# Example shape only (do not copy): [{"id":"frontdesk","name":"Front Desk","passwordHash":"scrypt$..."}]
ADMIN_USERS_JSON=
# Legacy single-user alternative (plain-text password; prefer ADMIN_USERS_JSON):
# ADMIN_USER_ID=
# ADMIN_USER_NAME=
# ADMIN_PASSWORD=
# Use a random secret of at least 32 characters. Rotate it to invalidate all staff sessions.
ADMIN_SESSION_SECRET=
# Leave false unless the hotel deliberately permits offline/pay-at-hotel confirmation by staff.
ADMIN_ALLOW_MANUAL_CONFIRM=false

# Concierge: hybrid uses operational rates/inventory + curated hotel knowledge.
CONCIERGE_PROVIDER=hybrid

# Optional booking pricing rules. These are public commercial values, never secrets.
# Extra-adult charge applies per extra adult per night only when INCLUDED_ADULTS_PER_ROOM is set.
NEXT_PUBLIC_INCLUDED_ADULTS_PER_ROOM=
NEXT_PUBLIC_EXTRA_ADULT_CHARGE=
# Child charge, when configured, applies per child per night.
NEXT_PUBLIC_CHILD_CHARGE=
# Optional fixed nightly adjustments for non-room-only rate plans.
# Example: [{"id":"breakfast","adjustmentValue":500,"onlineBookable":true,"description":"Breakfast for the booked room(s)."}]
NEXT_PUBLIC_RATE_PLAN_CONFIG_JSON=
# Optional add-on pricing/enablement. Existing charge mode comes from the application catalog.
# Example: [{"id":"breakfast","amount":300,"onlineBookable":true},{"id":"airport-pickup","amount":1200,"onlineBookable":true}]
NEXT_PUBLIC_ADDON_CONFIG_JSON=
# Optional promo rules — SERVER-ONLY (no NEXT_PUBLIC_ prefix, so codes are not published in the browser bundle).
# Codes are validated and applied when the room is held. Example: [{"code":"WELCOME10","type":"percent","value":10,"enabled":true,"startDate":"2026-10-01","endDate":"2026-12-31","minNights":2}]
PROMO_CODES_JSON=

# V2 public site identity / SEO.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional public-facing hotel email. Leave blank until the hotel approves one.
NEXT_PUBLIC_HOTEL_EMAIL=

# Transactional booking emails — Brevo (server-only).
# Free plan currently supports up to 300 email sends/day.
# Create the API key in Brevo: Settings > SMTP & API > API Keys & MCP.
BREVO_API_KEY=
# Must be a verified Brevo sender address, e.g. reservations@yourdomain.com
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_FROM_NAME=Tejjora Lake View
# Optional: replies from the guest can go to this approved hotel mailbox.
BOOKING_EMAIL_REPLY_TO=

# Optional concierge language polish. The structured hotel engine remains the source of truth.
# Values: structured | gemini
CONCIERGE_LANGUAGE_PROVIDER=structured
GEMINI_API_KEY=
GEMINI_CONCIERGE_MODEL=
