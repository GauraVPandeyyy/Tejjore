{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "src/lib/admin/auth.ts"
  ]
}
